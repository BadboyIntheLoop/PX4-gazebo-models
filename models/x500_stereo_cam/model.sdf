<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_stereo_cam'>
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Stereo Camera Link -->
    <link name="stereo_camera_link">
      <pose relative_to="base_link">0.12 0 -0.05 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.065</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <!-- Camera Housing Visual -->
      <visual name="stereo_camera/visual/housing">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.15 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>

      <!-- Left Lens Visual -->
      <visual name="stereo_camera/visual/left_lens">
        <pose>0.015 0.06 0 0 1.5707 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>

      <!-- Right Lens Visual -->
      <visual name="stereo_camera/visual/right_lens">
        <pose>0.015 -0.06 0 0 1.5707 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>

      <!-- Collision -->
      <collision name="stereo_camera/collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.15 0.03</size>
          </box>
        </geometry>
      </collision>

      <!-- Left Camera Sensor -->
      <sensor name="left_camera" type="camera">
        <pose>0 0.06 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov> <!-- 80 degrees -->
          <image>
            <width>752</width>
            <height>480</height>
            <format>L8</format> <!-- Grayscale for better VINS performance -->
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <lens>
            <intrinsics>
              <!-- fx fy cx cy -->
              <fx>458.654</fx>
              <fy>457.296</fy>
              <cx>367.215</cx>
              <cy>248.375</cy>
              <s>0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <topic>left/image_raw</topic>
      </sensor>

      <!-- Right Camera Sensor -->
      <sensor name="right_camera" type="camera">
        <pose>0 -0.06 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov> <!-- 80 degrees -->
          <image>
            <width>752</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <lens>
            <intrinsics>
              <!-- fx fy cx cy -->
              <fx>458.654</fx>
              <fy>457.296</fy>
              <cx>367.215</cx>
              <cy>248.375</cy>
              <s>0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <topic>right/image_raw</topic>
      </sensor>

      <!-- IMU Sensor for VIO -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.009</stddev>
                <dynamic_bias_stddev>0.00009</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.009</stddev>
                <dynamic_bias_stddev>0.00009</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.009</stddev>
                <dynamic_bias_stddev>0.00009</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.017</stddev>
                <dynamic_bias_stddev>0.001</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.017</stddev>
                <dynamic_bias_stddev>0.001</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.017</stddev>
                <dynamic_bias_stddev>0.001</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <topic>stereo_imu</topic>
      </sensor>

      <gravity>true</gravity>
    </link>

    <!-- Joint connecting stereo camera to base_link -->
    <joint name="stereo_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>stereo_camera_link</child>
      <pose relative_to="base_link">0.12 0 -0.05 0 0 0</pose>
    </joint>

  </model>
</sdf>
