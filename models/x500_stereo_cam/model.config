<?xml version="1.0"?>
<model>
  <name>x500_stereo_cam</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>SPhenikaa Development Team</name>
    <email>chung.nguyentat@phenikaa-uni.edu.vn</email>
